// Welcome sign, batch 1: BIENVENIDOS / A LA BODA DE and the "&", held in carrier frames.
// Build: python scripts/build_part.py printer/boda-letras-bienvenidos
//
// Each letter hangs between a rail above and a rail below by thin tabs, already spaced.
// Glue the letters to the board, let the glue cure, then cut the tabs and lift the frame away.
// The outlines come from shapes.scad, generated by
// printer/boda-janny-alex/design/make_print.py (do not edit shapes.scad by hand).

/* [Letters] */
height = 3;             // how far the letters stand off the board

/* [Carrier] */
tab_thickness = 0.6;    // thin enough to cut with flush cutters or a blade
// Tabs sit at mid-height on the side walls, so they touch neither the front nor the back face.
tab_z = (height - tab_thickness) / 2;
// The frame is this much lower than the letters, so it never touches the board (or the glue).
carrier_clearance = 0.6;

/* [Printing] */
// true: mirrored, the readable face prints on the plate (smoothest face).
// false: readable face up.
face_down = true;

include <shapes.scad>

module assembly() {
    linear_extrude(height) letters_2d();
    linear_extrude(height - carrier_clearance) carrier_2d();
    translate([0, 0, tab_z]) linear_extrude(tab_thickness) tabs_2d();
}

if (face_down) mirror([1, 0, 0]) assembly();
else assembly();
