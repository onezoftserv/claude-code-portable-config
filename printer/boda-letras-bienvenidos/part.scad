// Welcome sign, batch 1: BIENVENIDOS / A LA BODA DE and the "&", hanging from carrier rails.
// Build: python scripts/build_part.py printer/boda-letras-bienvenidos
//
// Each line hangs from a rail by thin tabs, already spaced. Glue the letters (not the rail)
// to the board, let the glue cure, then cut the tabs and lift the rail away.
// The outlines come from shapes.scad, generated by
// printer/boda-janny-alex/design/make_print.py (do not edit shapes.scad by hand).

/* [Letters] */
height = 3;           // how far the letters stand off the board

/* [Carrier] */
tab_thickness = 0.6;  // thin enough to cut with flush cutters or a blade

/* [Printing] */
// true: mirrored, the readable face prints on the plate (smoothest face); the tabs then
//       bridge at the back of the letters, which is the side that touches the board.
// false: readable face up; tabs lie on the plate.
face_down = true;

include <shapes.scad>

module assembly() {
    linear_extrude(height) letters_2d();
    linear_extrude(height) carrier_2d();
    translate([0, 0, face_down ? height - tab_thickness : 0])
        linear_extrude(tab_thickness) tabs_2d();
}

if (face_down) mirror([1, 0, 0]) assembly();
else assembly();
