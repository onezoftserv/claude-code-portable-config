// Welcome sign, batch 1: placement template for BIENVENIDOS / A LA BODA DE and the "&".
// Build: python scripts/build_part.py printer/boda-plantilla-bienvenidos
//
// Two thin plates with letter-shaped holes. The V notches at top and bottom sit on the
// board's vertical centre line. Positions on the board are in README.md.
// The outlines come from shapes.scad, generated by
// printer/boda-janny-alex/design/make_print.py (do not edit shapes.scad by hand).

/* [Template] */
thickness = 0.8;   // thinner than the letters, so they can be pressed down through it

include <shapes.scad>

linear_extrude(thickness)
    difference() {
        plates_2d();
        holes_2d();
    }
