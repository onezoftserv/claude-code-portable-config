{
  "model": "opusplan",
  "fallbackModel": ["sonnet"],
  "advisorModel": "opus",
  "subagentPromptCacheTtl": "1h",
  "permissions": {
    "allow": [
      "Bash(git status)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "PowerShell(git status)",
      "PowerShell(git diff*)",
      "PowerShell(git log*)",
      "PowerShell(git show*)"
    ],
    "ask": [
      "Bash(git reset --hard*)",
      "Bash(rm -rf*)",
      "PowerShell(git reset --hard*)",
      "PowerShell(Remove-Item -Recurse -Force*)"
    ]
  }
}
